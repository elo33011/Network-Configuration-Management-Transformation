! access-switch-NEW.tmpl  (copied from access-switch.tmpl after design change; old one never retired)
! Variables are filled in by the engineer at deployment time.
hostname {{ hostname }}
!
ntp server {{ ntp_server }}
ntp server {{ ntp_server_2 }}
logging host {{ syslog_server }}
snmp-server group MONITOR v3 priv
!
vlan {{ data_vlan }}
 name DATA
vlan {{ voice_vlan }}
 name VOICE
!
interface range {{ access_ports }}
 switchport mode access
 switchport access vlan {{ data_vlan }}
 switchport voice vlan {{ voice_vlan }}
 spanning-tree portfast
!
interface {{ uplink_1 }}
 description UPLINK-TO-{{ agg_1 }}
 switchport mode trunk
interface {{ uplink_2 }}
 description UPLINK-TO-{{ agg_2 }}
 switchport mode trunk
