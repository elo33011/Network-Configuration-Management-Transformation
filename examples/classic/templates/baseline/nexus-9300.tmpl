! baseline/nexus-9300.tmpl - hardware-platform baseline (identical for every environment)
! Stored in the execution platform - no version, no history.
hostname {{ hostname }}
!
feature ssh
feature lacp
feature lldp
!
ntp server {{ ntp_server }} use-vrf management
logging server {{ syslog_server }} use-vrf management
snmp-server community {{ snmp_community }} ro
!
aaa authentication login default group tacacs+ local
banner motd ^Authorised use only^
!
vrf context management
 ip route 0.0.0.0/0 {{ mgmt_gateway }}
interface mgmt0
 vrf member management
 ip address {{ mgmt_ip }}
!
copp profile strict
